#!/usr/bin/env sh
# Lightweight Gradle bootstrapper: downloads Gradle 8.13 when no system Gradle exists.
set -eu
GRADLE_VERSION="8.13"
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
GRADLE_HOME_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/manual-dists/gradle-${GRADLE_VERSION}"
GRADLE_BIN="$GRADLE_HOME_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$(dirname "$GRADLE_HOME_DIR")"
  ZIP_FILE="${TMPDIR:-/tmp}/gradle-${GRADLE_VERSION}-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  echo "Gradle ${GRADLE_VERSION} no está instalado. Descargándolo..."
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$URL" -o "$ZIP_FILE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP_FILE" "$URL"
  else
    echo "Necesitas curl o wget para descargar Gradle." >&2
    exit 1
  fi
  unzip -q -o "$ZIP_FILE" -d "$(dirname "$GRADLE_HOME_DIR")"
  rm -f "$ZIP_FILE"
fi
exec "$GRADLE_BIN" "$@"
